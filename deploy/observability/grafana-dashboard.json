{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Operational dashboard for Concert waiting-room proxy, guardrails, upstream origin health, concert-kv/concert-cache hit ratios, and 4-chain (Solana, Stellar, Hedera, XRPL) Fast-Lane & Priority Bidding.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Waiting Room: Occupancy vs Cap & Readiness",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current in-flight page requests compared against configured capacity cap and signed lease ceiling.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_room_occupancy{instance=~\"$instance\"}",
          "legendFormat": "Occupancy ({{instance}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_room_cap{instance=~\"$instance\"}",
          "legendFormat": "Capacity Cap ({{instance}})",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_room_lease_ceiling{instance=~\"$instance\"}",
          "legendFormat": "Lease Ceiling ({{instance}})",
          "refId": "C"
        }
      ],
      "title": "Occupancy vs Capacity Cap",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Smoothed waiting-room utilization ratio and drain indicator.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.75 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(concert_room_utilization{instance=~\"$instance\"})",
          "legendFormat": "Utilization",
          "refId": "A"
        }
      ],
      "title": "Room Utilization (Smoothed)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Concert readiness state (1 = ready, 0 = draining or all origins unhealthy) and cap draining indicator.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "NOT READY" }, "1": { "color": "green", "text": "READY" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "min(concert_ready{instance=~\"$instance\"})",
          "legendFormat": "Ready",
          "refId": "A"
        }
      ],
      "title": "Cluster Readiness",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Queue Depth & Live ETA",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Active waiting visitors, total queued tickets, and configured max queue breaker threshold.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_room_live_queue_depth{instance=~\"$instance\"}",
          "legendFormat": "Live Queue Depth ({{instance}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_room_queue_depth{instance=~\"$instance\"}",
          "legendFormat": "Total Queue Depth ({{instance}})",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_room_max_queue_depth{instance=~\"$instance\"} > 0",
          "legendFormat": "Max Queue Cap ({{instance}})",
          "refId": "C"
        }
      ],
      "title": "Queue Depth vs Max Queue Breaker",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Estimated wait time derived from live queue depth divided by the 5-minute promotion rate.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_room_live_queue_depth{instance=~\"$instance\"} / clamp_min(rate(concert_room_promoted_total{instance=~\"$instance\"}[5m]), 0.001)",
          "legendFormat": "Live ETA ({{instance}})",
          "refId": "A"
        }
      ],
      "title": "Live Queue ETA (Estimated Wait)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Queue arrivals, promotions, evictions, and admission timeouts per second.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_room_queued_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Queued/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_room_promoted_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Promoted/s",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_room_evicted_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Evicted/s",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_room_timeouts_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Timeouts/s",
          "refId": "D"
        }
      ],
      "title": "Queue Lifecycle Rates",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 9,
      "title": "503 Breaker & Guard / PoW / Rate-Limit Drops",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "503 capacity breaker rejections, host-protection shedding, and per-IP queue quota rejections.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_room_rejected_503_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "503 Queue Full Breaker/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_guard_shed_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Guard Host Shed 503/s",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_guard_quota_rejected_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Per-IP Quota Rejected/s",
          "refId": "C"
        }
      ],
      "title": "503 Breaker & Host Shedding",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Per-route 429 rate limits, Geo/ASN 403 blocks, and pre-ticket PoW / Turnstile challenge outcomes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_guard_ratelimit_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Rate-Limit 429/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_guard_geo_blocked_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Geo/ASN Blocked 403/s",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_guard_challenge_passed_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "PoW/Turnstile Passed/s",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_guard_challenge_failed_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "PoW/Turnstile Failed/s",
          "refId": "D"
        }
      ],
      "title": "Guard Rate-Limits, Geo Blocks & PoW Challenges",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Active client/CIDR bans and rejected request rates from abuse registry and pass token verification.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 12,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(concert_abuse_active_bans{instance=~\"$instance\"})",
          "legendFormat": "Active Bans",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(concert_abuse_range_bans{instance=~\"$instance\"})",
          "legendFormat": "Active CIDR Bans",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_abuse_rejected_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Ban Rejects/s",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_room_token_rejected_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Invalid Token Rejects/s",
          "refId": "D"
        }
      ],
      "title": "Abuse Bans & Token Rejections",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 13,
      "title": "Upstream Origin Health & Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Healthy versus configured upstream origin backends.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 },
      "id": 14,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_upstream_backends_healthy{instance=~\"$instance\"}",
          "legendFormat": "Healthy ({{instance}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_upstream_backends_total{instance=~\"$instance\"}",
          "legendFormat": "Total ({{instance}})",
          "refId": "B"
        }
      ],
      "title": "Upstream Backends Healthy vs Total",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Origin round-trip latency p50, p95, and p99 from concert_upstream_duration_seconds_bucket.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 28 },
      "id": 15,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(concert_upstream_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(concert_upstream_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(concert_upstream_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Upstream Origin Latency (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Proxied upstream responses by status class alongside transport errors and response-body idle timeouts.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 28 },
      "id": 16,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (status_class) (rate(concert_upstream_requests_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "HTTP {{status_class}}/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_upstream_errors_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Transport/Circuit Errors/s",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_upstream_body_idle_timeouts_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "Body Idle Timeouts/s",
          "refId": "C"
        }
      ],
      "title": "Upstream Status Classes, Errors & Body Idle Timeouts",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 17,
      "title": "concert-kv Cluster Sync & concert-cache / Microcache Hit Ratios",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Hit ratio for external concert-cache daemon and Concert's in-memory anonymous micro-cache.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "id": 18,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_cache_hits_total[5m])) / clamp_min(sum(rate(concert_cache_hits_total[5m])) + sum(rate(concert_cache_misses_total[5m])), 1e-9)",
          "legendFormat": "concert-cache Hit Ratio",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_microcache_hits_total{instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(concert_microcache_hits_total{instance=~\"$instance\"}[5m])) + sum(rate(concert_microcache_misses_total{instance=~\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "In-Memory Microcache Hit Ratio",
          "refId": "B"
        }
      ],
      "title": "concert-cache & Microcache Hit Ratios",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "concert-cache memory utilization, singleflight coalescing, and LRU eviction rates.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 37 },
      "id": 19,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_cache_used_bytes",
          "legendFormat": "concert-cache Used ({{instance}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_cache_max_bytes",
          "legendFormat": "concert-cache Max ({{instance}})",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "concert_microcache_bytes{instance=~\"$instance\"}",
          "legendFormat": "Microcache Used ({{instance}})",
          "refId": "C"
        }
      ],
      "title": "Cache Memory Footprint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "concert-kv cluster state synchronization throughput, errors, and concert-cache coalesced/evicted rates.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 37 },
      "id": 20,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(concert_cluster_sync_sent_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "KV Sync Sent/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
