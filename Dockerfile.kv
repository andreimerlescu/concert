# syntax=docker/dockerfile:1

ARG GO_VERSION=1.27
ARG GOFIPS140=off
ARG VERSION=v0.3.0

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS builder

WORKDIR /src
ENV GOTOOLCHAIN=auto

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY VERSION LICENSE version.go ./
COPY cmd/concert-kv ./cmd/concert-kv
COPY internal ./internal

ARG TARGETOS
ARG TARGETARCH
ARG GOFIPS140

RUN CGO_ENABLED=0 \
    GOOS=${TARGETOS:-linux} \
    GOARCH=${TARGETARCH:-amd64} \
    GOFIPS140=${GOFIPS140} \
    go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/concert-kv ./cmd/concert-kv && \
    mkdir -p /rootfs/var/lib/concert-kv /rootfs/run/concert-kv && \
    chmod 0700 /rootfs/var/lib/concert-kv /rootfs/run/concert-kv

# Minimal, non-root, distroless runtime image (no shell, no package manager).
FROM gcr.io/distroless/static-debian12:nonroot

ARG VERSION=v0.3.0

LABEL org.opencontainers.image.title="concert-kv" \
      org.opencontainers.image.description="Pure-Go RESP2 Key-Value, Pub/Sub, and Shared Queue Daemon for Concert Clusters" \
      org.opencontainers.image.source="https://github.com/andreimerlescu/concert" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}"

COPY --from=builder /out/concert-kv /usr/local/bin/concert-kv
COPY --from=builder --chown=65532:65532 /rootfs/var/lib/concert-kv /var/lib/concert-kv
COPY --from=builder --chown=65532:65532 /rootfs/run/concert-kv /run/concert-kv

EXPOSE 6379/tcp 6380/tcp
VOLUME ["/var/lib/concert-kv"]

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/concert-kv"]
